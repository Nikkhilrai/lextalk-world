// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Leads / Registrations Model
model Lead {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  contact      String
  organization String?
  designation  String?
  country      String
  joinAs       String?
  conference   String?
  query        String?
  status       String   @default("New") // New, Contacted, Converted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Blog Post Model
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  image       String
  category    String
  author      String
  authorImage String?
  readTime    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Award Model (for future use)
model Award {
  id          String   @id @default(cuid())
  name        String
  title       String
  company     String
  category    String
  year        Int
  image       String?
  description String?
  eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Advisory Board Model
model Advisor {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String
  image       String
  linkedin    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Newsletter Subscriber Model
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("Subscribed") // Subscribed, Unsubscribed
  createdAt DateTime @default(now())
}

// Speaker Model
model Speaker {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  bio       String?
  image     String
  linkedin  String?
  twitter   String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sponsor Model
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  website   String?
  image     String   // Logo
  tier      String   // Platinum, Gold, Silver, Media Partner
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conference/Event Model
model Conference {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  location    String       // City, Country
  venue       String       // Venue name
  description String?      @db.Text
  startDate   DateTime
  endDate     DateTime
  status      String       @default("draft") // draft, active, completed, cancelled
  imageUrl    String?
  tickets     TicketType[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Ticket Types for Conferences
model TicketType {
  id           String        @id @default(cuid())
  conferenceId String
  conference   Conference    @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  type         String        // standard, premium, vip
  name         String        // "Early Bird Standard", "VIP All Access", etc.
  price        Float
  currency     String        @default("USD")
  maxQuantity  Int?          // null means unlimited
  soldCount    Int           @default(0)
  benefits     String?       @db.Text // JSON array or newline-separated
  isActive     Boolean       @default(true)
  orders       TicketOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Ticket Orders/Purchases
model TicketOrder {
  id           String     @id @default(cuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  quantity     Int
  totalAmount  Float
  currency     String     @default("USD")
  status       String     @default("pending") // pending, paid, cancelled, refunded
  paymentId    String?    // External payment gateway reference
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Login Attempts for Security
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// About Page Content Model
model AboutPage {
  id               String   @id @default(cuid())
  // Hero Section
  heroTagline      String   @default("Connecting Legal Minds Worldwide")
  heroTitle        String   @default("About LexTalk World")
  heroSubtitle     String   @db.Text
  // Stats Section (JSON array)
  stats            String   @db.Text // JSON: [{number, suffix, label, icon}]
  // Our Story Section
  storyTitle       String   @default("Building Bridges Across the Global Legal Community")
  storyContent     String   @db.Text
  // Mission & Vision
  missionTitle     String   @default("Our Mission")
  missionContent   String   @db.Text
  visionTitle      String   @default("Our Vision")
  visionContent    String   @db.Text
  // Core Values (JSON array)
  values           String   @db.Text // JSON: [{icon, title, description, color}]
  // Journey/Milestones (JSON array)
  milestones       String   @db.Text // JSON: [{year, title, description}]
  // Settings
  isPublished      Boolean  @default(false)
  showInNavbar     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
