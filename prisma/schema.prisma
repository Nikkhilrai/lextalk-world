// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Leads / Registrations Model
model Lead {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  contact      String
  organization String?
  designation  String?
  country      String
  joinAs       String?
  conference   String?
  query        String?
  status       String   @default("New") // New, Contacted, Converted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Blog Post Model
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  image       String
  category    String
  author      String
  authorImage String?
  readTime    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Award Model (for future use)
model Award {
  id          String   @id @default(cuid())
  name        String
  title       String
  company     String
  category    String
  year        Int
  image       String?
  description String?
  eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Advisory Board Model
model Advisor {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String
  image       String
  linkedin    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
