// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Leads / Registrations Model
model Lead {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  contact      String
  organization String?
  designation  String?
  country      String
  joinAs       String?
  conference   String?
  query        String?
  status       String   @default("New") // New, Contacted, Converted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Blog Post Model
model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  image       String
  category    String
  author      String
  authorImage String?
  readTime    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Award Model (for future use)
model Award {
  id          String   @id @default(cuid())
  name        String
  title       String
  company     String
  category    String
  year        Int
  image       String?
  description String?
  eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Advisory Board Model
model Advisor {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String
  image       String
  linkedin    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Newsletter Subscriber Model
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("Subscribed") // Subscribed, Unsubscribed
  createdAt DateTime @default(now())
}

// Speaker Model
model Speaker {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  bio       String?
  image     String
  linkedin  String?
  twitter   String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sponsor Model
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  website   String?
  image     String   // Logo
  tier      String   // Platinum, Gold, Silver, Media Partner
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
