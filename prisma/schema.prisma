// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Leads / Registrations Model
model Lead {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  contact      String
  organization String?
  designation  String?
  country      String
  joinAs       String?
  conference   String?
  query        String?
  status       String   @default("New") // New, Contacted, Converted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Blog Post Model
model BlogPost {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  excerpt         String
  content         String
  image           String
  category        String
  author          String
  authorImage     String?
  readTime        String?
  featured        Boolean  @default(false)
  published       Boolean  @default(false)
  // SEO Fields
  tags            String?  // Comma-separated tags for SEO (e.g., "legal tech, AI, contracts")
  metaDescription String?  // Custom meta description for search engines
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Blog Category Model
model BlogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  color     String   @default("#F59E0B") // Amber default
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog Author Model
model BlogAuthor {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String?
  bio       String?  @db.Text
  role      String?  // e.g., "Legal Tech Expert", "Senior Editor"
  email     String?
  linkedin  String?
  twitter   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Blog Comment Model
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  postSlug  String   // For easier querying
  name      String
  email     String
  content   String   @db.Text
  approved  Boolean  @default(false) // Requires admin approval
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([postSlug])
  @@index([email])
}

// Award Model (for future use)
model Award {
  id          String   @id @default(cuid())
  name        String
  title       String
  company     String
  category    String
  year        Int
  image       String?
  description String?
  eventId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Advisory Board Model
model Advisor {
  id          String   @id @default(cuid())
  name        String
  role        String
  company     String
  image       String
  linkedin    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Newsletter Subscriber Model
model Subscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  firstName        String?
  lastName         String?
  source           String?  // website, delegate, lead, manual
  status           String   @default("Subscribed") // Subscribed, Unsubscribed
  unsubscribeToken String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([email])
  @@index([status])
}

// Speaker Model
model Speaker {
  id        String   @id @default(cuid())
  name      String
  role      String
  company   String
  bio       String?
  image     String
  linkedin  String?
  twitter   String?
  featured  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Sponsor Model
model Sponsor {
  id        String   @id @default(cuid())
  name      String
  website   String?
  image     String   // Logo
  tier      String   // Platinum, Gold, Silver, Media Partner
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String   // Hashed password
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conference/Event Model
model Conference {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  location    String       // City, Country
  venue       String       // Venue name
  description String?      @db.Text
  startDate   DateTime
  endDate     DateTime
  status      String       @default("draft") // draft, active, completed, cancelled
  imageUrl    String?
  tickets     TicketType[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Ticket Types for Conferences
model TicketType {
  id           String        @id @default(cuid())
  conferenceId String
  conference   Conference    @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
  type         String        // standard, premium, vip
  name         String        // "Early Bird Standard", "VIP All Access", etc.
  price        Float
  currency     String        @default("USD")
  maxQuantity  Int?          // null means unlimited
  soldCount    Int           @default(0)
  benefits     String?       @db.Text // JSON array or newline-separated
  isActive     Boolean       @default(true)
  orders       TicketOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Ticket Orders/Purchases
model TicketOrder {
  id           String     @id @default(cuid())
  ticketTypeId String
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  buyerName    String
  buyerEmail   String
  buyerPhone   String?
  quantity     Int
  totalAmount  Float
  currency     String     @default("USD")
  status       String     @default("pending") // pending, paid, cancelled, refunded
  paymentId    String?    // External payment gateway reference
  notes        String?
  ticketNumber String?    // Unique ticket ID (e.g., LTW-2026-ABC123)
  ticketPdfUrl String?    // URL to generated PDF ticket
  qrCodeData   String?    // Encrypted data for QR code verification
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Login Attempts for Security
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// About Page Content Model
model AboutPage {
  id               String   @id @default(cuid())
  // Hero Section
  heroTagline      String   @default("Connecting Legal Minds Worldwide")
  heroTitle        String   @default("About LexTalk World")
  heroSubtitle     String   @db.Text
  // Stats Section (JSON array)
  stats            String   @db.Text // JSON: [{number, suffix, label, icon}]
  // Our Story Section
  storyTitle       String   @default("Building Bridges Across the Global Legal Community")
  storyContent     String   @db.Text
  // Mission & Vision
  missionTitle     String   @default("Our Mission")
  missionContent   String   @db.Text
  visionTitle      String   @default("Our Vision")
  visionContent    String   @db.Text
  // Core Values (JSON array)
  values           String   @db.Text // JSON: [{icon, title, description, color}]
  // Journey/Milestones (JSON array)
  milestones       String   @db.Text // JSON: [{year, title, description}]
  // Settings
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Award Nomination Model
model Nomination {
  id              String   @id @default(cuid())
  // Core Info
  type            String   @default("Individual") // "Individual" | "Firm"
  category        String
  
  // Dynamic Form Data (Education, Bar, Practice Areas, Essay, Address, etc.)
  formResponse    Json?
  
  // Contact (Indexed for search)
  nominatorEmail  String
  nominatorPhone  String?
  nomineeName     String
  nomineeEmail    String
  
  status          String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, COMPLETED
  paymentId       String?  @unique // Link to Payment model
  payment         Payment? @relation(fields: [paymentId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Payment Transaction Model
model Payment {
  id              String      @id @default(cuid())
  amount          Float
  currency        String      @default("USD")
  stripePaymentId String?     @unique // Stripe PaymentIntent ID
  status          String      @default("pending") // pending, succeeded, failed
  
  nomination      Nomination?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// Award Event Model (e.g., Dubai 2024, New York 2025, etc.)
model AwardEvent {
  id          String    @id @default(cuid())
  name        String    // "Dubai 2024", "New York 2025", etc.
  slug        String    @unique // "dubai-2024", "new-york-2025"
  location    String    // "Dubai, UAE"
  year        Int       // 2024, 2025
  date        DateTime? // Event date
  description String?   @db.Text
  image       String?   // Cover image for the event
  isActive    Boolean   @default(true)
  order       Int       @default(0) // For ordering in lists
  awardees    Awardee[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Awardee Model
model Awardee {
  id           String     @id @default(cuid())
  name         String
  designation  String?    // "Senior Partner", "Managing Director"
  organization String?    // "Law Firm Name"
  category     String     // "Inspiring Individuals", "Excellence in Law", "Rising Star"
  bio          String?    @db.Text
  image        String?    // Profile photo
  country      String?
  linkedin     String?
  email        String?
  order        Int        @default(0) // For ordering within category
  isPublished  Boolean    @default(true)
  eventId      String
  event        AwardEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([eventId])
  @@index([category])
}

// Agenda Download Lead Capture
model AgendaDownload {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  designation  String
  organization String
  phone        String
  eventSlug    String   // e.g., "dubai-2026", "houston-2026"
  agendaUrl    String?  // URL to the uploaded agenda PDF
  downloaded   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([eventSlug])
  @@index([createdAt])
}

// Stores the uploaded agenda PDF URL per event (set by admin)
model EventAgenda {
  id        String   @id @default(cuid())
  eventSlug String   @unique // e.g., "dubai-2026", "mumbai-2026"
  url       String   // Cloudinary URL or local path
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact Form Messages
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String
  message   String   @db.Text
  status    String   @default("New") // New, Read, Replied
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Sponsorship Inquiry Model
model SponsorshipInquiry {
  id                   String   @id @default(cuid())
  fullName             String
  email                String
  contactNumber        String
  country              String
  organization         String
  designation          String
  additionalInfo       String?  @db.Text
  attachmentUrl        String?  // URL to uploaded file (if any)
  status               String   @default("New") // New, Contacted, Converted
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Delegate Registration for Conferences (Dubai 2026, etc.)
model DelegateRegistration {
  id                String   @id @default(cuid())
  // User Details
  firstName         String
  lastName          String
  email             String
  phone             String?
  organization      String?
  designation       String?
  country           String
  
  // Pass Details
  passType          String   // visitor, full-access, full-access-vip, vendor, vendor-vip
  passCategory      String   // individual, team
  conferenceSlug    String   // dubai-2026, houston-2026
  
  // Pricing
  originalPrice     Float
  discountedPrice   Float
  currency          String   @default("USD")
  
  // Payment Details
  paymentType       String?  // india, international, free
  paymentStatus     String   @default("pending") // pending, success, failed
  razorpayOrderId   String?
  razorpayPaymentId String?  @unique
  
  // Coupon
  couponCode        String?           // Coupon code used (if any)
  couponDiscount    Float?            // Discount % applied

  // Ticket
  ticketNumber      String?  @unique
  ticketId          String?  @unique @default(uuid())
  emailSent         Boolean  @default(false)
  
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([passType])
  @@index([passCategory])
  @@index([paymentStatus])
  @@index([conferenceSlug])
  @@index([ticketId])
  @@index([createdAt])
}


// Delegate Coupon Model
model DelegateCoupon {
  id             String   @id @default(cuid())
  code           String   @unique  // e.g. "SAVE15", "VIP2026"
  name           String            // Display name: "VIP Partner Discount"
  discountPct    Float             // 15 = 15% discount
  validFrom      DateTime @default(now())
  validUntil     DateTime
  maxUses        Int?              // null = unlimited
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  conferenceSlug String?           // null = all conferences
  applicableTo   String?           // null = all passes, or "student,delegate,vendor"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}

// Reserve Your Seat / Seat Reservation Model
model SeatReservation {
  id           String   @id @default(cuid())
  fullName     String
  workEmail    String
  organization String
  role         String   // In-House Counsel, Law Firm Partner, etc.
  passType     String   // Visitor Pass, Full Access Pass, etc.
  status       String   @default("New") // New, Contacted
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workEmail])
  @@index([status])
  @@index([createdAt])
}

// Admin Notifications
model Notification {
  id          String   @id @default(cuid())
  type        String   // "CONTACT", "AGENDA_DOWNLOAD", "NEWSLETTER", "TICKET_PURCHASE", "SPONSORSHIP", "SEAT_RESERVATION", "AWARD_NOMINATION", "COMMENT"
  message     String
  referenceId String?  // ID of the related record
  read        Boolean  @default(false)
  link        String?  // Link to the detailed view if applicable
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([read])
  @@index([createdAt])
}

// Counsel Exchange Access Request (Inside the Room page)
model CounselExchangeRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  country     String
  organization String
  designation String
  message     String?
  status      String   @default("New") // New, Reviewed, Approved, Rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Speaker Application / Interest Form
model SpeakerApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  country    String
  company    String
  designation String
  conference String   // Which conference they're interested in
  status     String   @default("New") // New, Reviewed, Shortlisted, Rejected
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// Newsletter Models
model Newsletter {
  id             String           @id @default(cuid())
  subject        String
  previewText    String?
  htmlContent    String           @db.Text
  status         String           @default("draft") // draft | sending | sent | failed
  recipientCount Int              @default(0)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  sends          NewsletterSend[]

  @@index([status])
  @@index([createdAt])
}

model NewsletterSend {
  id           String     @id @default(cuid())
  newsletterId String
  email        String
  name         String?
  source       String     // delegate | lead | subscriber | sponsorship | counsel
  status       String     @default("sent") // sent | failed
  error        String?
  sentAt       DateTime   @default(now())
  newsletter   Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)

  @@index([newsletterId])
  @@index([email])
  @@index([status])
}
