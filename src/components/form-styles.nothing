@import "tailwindcss";

@layer utilities {
  .label {
    @apply block text-sm font-bold text-slate-700 mb-1.5 uppercase tracking-wide;
  }
  .input {
    @apply w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none transition-all placeholder:text-slate-400 bg-white;
  }
  .btn-primary {
    @apply px-8 py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-full transition-all shadow-lg hover:shadow-amber-500/25 disabled:opacity-50 disabled:cursor-not-allowed;
  }
  .btn-secondary {
    @apply px-6 py-3 bg-white border border-slate-200 hover:border-slate-300 text-slate-700 font-bold rounded-full transition-all hover:bg-slate-50;
  }
  .section-title {
    @apply text-sm font-bold text-slate-400 uppercase tracking-wider mb-4;
  }
}
